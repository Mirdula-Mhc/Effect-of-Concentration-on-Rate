  m_Script: {fileID: 11500000, guid: d01fd2d64a9249049aaa77d5c12a82fe, type: 3}
  m_Name: Question 4
  m_EditorClassIdentifier: 
  questionText: '4. Which of the following processes is not advisable while carrying
    out the experiment?

'
  referenceImage: {fileID: 0}
  explanationText: 'Taking other chemicals in the same measuring cylinder will change
    the required concentration as

    some amount of the solution will be adhering
    to its walls. Hence, wash and dry the measuring cylinder

    every time before
    use or use a different measuring cylinder for each chemical.'
  options:
  - 'Stir the mixture after the addition of all the chemicals.  '
  - 'Start the stopwatch immediately after adding H2O2. '
  - 'Use the same measuring cylinders to add the chemicals. '
  - Both A and C
  correctOptionIndex: 2
