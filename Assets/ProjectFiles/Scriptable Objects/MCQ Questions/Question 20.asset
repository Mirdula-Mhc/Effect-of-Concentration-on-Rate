  m_Name: Question 20
  m_EditorClassIdentifier: Assembly-CSharp::MCQQuestionData
  questionText: The liberated iodine immediately reacts with the thiosulphate ions
    to form iodide and tetrathionate ions. lodine undergoes which of the following
    reactions?
  referenceImage: {fileID: 0}
  explanationText: The liberated iodine immediately reacts with the thiosulphate
    ions and undergoes reduction to form iodide and tetrathionate ions.
  options:
  - 'Oxidation   '
  - 'Reduction   '
  - 'Redox reaction  '
  - ' None of the above'
